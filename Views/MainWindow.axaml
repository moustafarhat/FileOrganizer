<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FileOrganizer.ViewModels"
        xmlns:m="using:FileOrganizer.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1050" d:DesignHeight="760"
        x:Class="FileOrganizer.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1100" Height="800"
        Icon="/Assets/avalonia-logo.ico"
        Title="File Organizer">

    <Window.Resources>
        <x:Double x:Key="LabelWidth">120</x:Double>
    </Window.Resources>

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <DockPanel LastChildFill="True" Margin="12">

        <!-- Folders row -->
        <Border DockPanel.Dock="Top" Padding="0,0,0,8">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Grid.Column="0" Text="Folders:" VerticalAlignment="Top" Margin="0,6,8,0" FontWeight="SemiBold"/>

                <Border Grid.Column="1" Name="FolderDropZone"
                        BorderBrush="#ccc" BorderThickness="1" CornerRadius="4"
                        MinHeight="72" Padding="6"
                        DragDrop.AllowDrop="True">
                    <Grid>
                        <TextBlock Text="Drop folders here, or click Add..."
                                   Foreground="#aaa" FontStyle="Italic"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsVisible="{Binding HasNoFolders}"/>
                        <ListBox ItemsSource="{Binding Folders}"
                                 SelectedItem="{Binding SelectedFolder}"
                                 BorderThickness="0" Background="Transparent"
                                 IsVisible="{Binding HasFolders}"
                                 MaxHeight="120">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontFamily="Consolas,Menlo,monospace" FontSize="12"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2" Spacing="4" Margin="8,0,0,0" VerticalAlignment="Top">
                    <Button Content="Add..." Command="{Binding AddFoldersCommand}" HorizontalContentAlignment="Center" Width="88"/>
                    <Button Content="Remove" Command="{Binding RemoveFolderCommand}" HorizontalContentAlignment="Center" Width="88"/>
                    <Button Content="Clear" Command="{Binding ClearFoldersCommand}" HorizontalContentAlignment="Center" Width="88"/>
                    <CheckBox Content="Recursive" IsChecked="{Binding Recursive}" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Preset + global actions row -->
        <Border DockPanel.Dock="Top" Padding="0,0,0,10" BorderBrush="#eee" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" Margin="0,0,0,8">
                <TextBlock Grid.Column="0" Text="Preset:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding Presets}"
                          SelectedItem="{Binding SelectedPreset}"
                          PlaceholderText="(none)"
                          MinWidth="200">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="m:Preset">
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBox Grid.Column="2" Text="{Binding NewPresetName}" PlaceholderText="New preset name" Width="160" Margin="8,0,0,0"/>
                <Button Grid.Column="3" Content="Save" Command="{Binding SavePresetCommand}" Margin="4,0,0,0"/>
                <Button Grid.Column="4" Content="Delete" Command="{Binding DeletePresetCommand}" Margin="4,0,12,0"/>

                <Button Grid.Column="5"
                        Content="{Binding UndoLabel}"
                        Command="{Binding UndoLastCommand}"
                        IsEnabled="{Binding CanUndo}"
                        Margin="0,0,12,0"/>

                <ToggleButton Grid.Column="6"
                              Content="Watch"
                              IsChecked="{Binding IsWatching, Mode=OneWay}"
                              Command="{Binding ToggleWatchCommand}"/>

                <Border Grid.Column="7" Background="#dcfce7" CornerRadius="10" Padding="8,2" Margin="8,0,0,0"
                        IsVisible="{Binding IsWatching}">
                    <TextBlock Text="● Watching" Foreground="#166534" FontSize="11" FontWeight="SemiBold"/>
                </Border>

                <TextBlock Grid.Column="8" Text=" "/>
                <Button Grid.Column="9" Content="Shell integration…" Command="{Binding ShellIntegrationCommand}" Margin="8,0,0,0"/>
            </Grid>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Padding="0,8,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding StatusText}" VerticalAlignment="Center" Foreground="#666" TextWrapping="Wrap"/>
                <ProgressBar Grid.Column="1" IsIndeterminate="True" IsVisible="{Binding IsBusy}" Width="120" Height="6"/>
            </Grid>
        </Border>

        <!-- Bottom action bar for Organize/Rename tabs -->
        <Border DockPanel.Dock="Bottom" Padding="0,8,0,0"
                IsVisible="{Binding SelectedTabIndex, Converter={x:Static m:TabIndexNotEqualsConverter.Instance}, ConverterParameter=2}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="Clear" Command="{Binding ClearCommand}"/>
                <Button Content="Preview" Command="{Binding PreviewCommand}"/>
                <Button Content="Apply" Command="{Binding ApplyCommand}"
                        Background="#2563eb" Foreground="White"/>
            </StackPanel>
        </Border>

        <!-- Main content -->
        <Grid RowDefinitions="Auto,*">
            <TabControl Grid.Row="0" SelectedIndex="{Binding SelectedTabIndex}" Margin="0,0,0,8">

                <!-- Organize tab -->
                <TabItem Header="Organize">
                    <Grid Margin="0,12,0,0" RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Group by:" VerticalAlignment="Center" Width="{StaticResource LabelWidth}"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding OrganizeModes}" SelectedItem="{Binding OrganizeMode}" MinWidth="200"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Date granularity:" VerticalAlignment="Center" Margin="0,8,0,0" Width="{StaticResource LabelWidth}"
                                   IsVisible="{Binding OrganizeMode, Converter={x:Static m:OrganizeModeIsDateConverter.Instance}}"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0"
                                    IsVisible="{Binding OrganizeMode, Converter={x:Static m:OrganizeModeIsDateConverter.Instance}}">
                            <ComboBox ItemsSource="{Binding DateGranularities}" SelectedItem="{Binding DateGranularity}" MinWidth="160"/>
                            <ComboBox ItemsSource="{Binding DateSources}" SelectedItem="{Binding DateSource}" MinWidth="160"/>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- Rename tab -->
                <TabItem Header="Rename">
                    <Grid Margin="0,12,0,0" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Style:" VerticalAlignment="Center" Width="{StaticResource LabelWidth}"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding RenameStyles}" SelectedItem="{Binding RenameStyle}" MinWidth="200"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Custom pattern:" VerticalAlignment="Center" Margin="0,8,0,0" Width="{StaticResource LabelWidth}"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CustomPattern}" Margin="0,8,0,0"
                                 PlaceholderText="e.g. {date:yyyy-MM-dd}_{snake}{ext}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Sequence:" VerticalAlignment="Center" Margin="0,8,0,0" Width="{StaticResource LabelWidth}"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                            <TextBlock Text="Start" VerticalAlignment="Center"/>
                            <NumericUpDown Value="{Binding SequenceStart}" Minimum="0" Maximum="999999" Width="100"/>
                            <TextBlock Text="Padding" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            <NumericUpDown Value="{Binding SequencePadding}" Minimum="1" Maximum="10" Width="80"/>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- Duplicates tab -->
                <TabItem Header="Duplicates">
                    <StackPanel Margin="0,12,0,0" Spacing="8">
                        <TextBlock Text="Find files with identical content across all selected folders (size pre-filter + SHA-256). Select copies to quarantine — undo restores them."
                                   Foreground="#666" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Scan for duplicates" Command="{Binding ScanDuplicatesCommand}"/>
                            <Button Content="Move selected to quarantine"
                                    Command="{Binding RemoveDuplicatesCommand}"
                                    Background="#dc2626" Foreground="White"/>
                        </StackPanel>
                    </StackPanel>
                </TabItem>
            </TabControl>

            <!-- Operations preview list (Organize / Rename) -->
            <Border Grid.Row="1" BorderBrush="#ddd" BorderThickness="1" CornerRadius="4"
                    IsVisible="{Binding SelectedTabIndex, Converter={x:Static m:TabIndexNotEqualsConverter.Instance}, ConverterParameter=2}">
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Operations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="m:PlannedOperation">
                                <Border Padding="8,6" BorderBrush="#eee" BorderThickness="0,0,0,1">
                                    <Grid ColumnDefinitions="*,Auto,*,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding SourceName}" FontFamily="Consolas,Menlo,monospace" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="  →  " Foreground="#888" Margin="8,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding TargetRelative}" FontFamily="Consolas,Menlo,monospace" Foreground="#2563eb" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Status}" FontSize="11" Margin="12,0,0,0" Foreground="#666"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Duplicates list -->
            <Border Grid.Row="1" BorderBrush="#ddd" BorderThickness="1" CornerRadius="4"
                    IsVisible="{Binding SelectedTabIndex, Converter={x:Static m:TabIndexEqualsConverter.Instance}, ConverterParameter=2}">
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Duplicates}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DuplicateGroupViewModel">
                                <Border Padding="8,8" BorderBrush="#eee" BorderThickness="0,0,0,1">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" Foreground="#444"/>
                                        <ItemsControl ItemsSource="{Binding Files}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:DuplicateFileViewModel">
                                                    <Grid ColumnDefinitions="Auto,*" Margin="8,2,0,2">
                                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelectedForRemoval}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Path}" FontFamily="Consolas,Menlo,monospace"
                                                                   VerticalAlignment="Center" Margin="6,0,0,0" TextTrimming="CharacterEllipsis"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
